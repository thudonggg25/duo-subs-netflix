{
  "manifest_version": 3,
  "name": "phimhz",
  "version": "0.1.0",
  "description": "Hai phụ đề, dịch tiếng Việt bằng AI và thuyết minh cho Disney+, HBO Max, Prime Video, Apple TV. Bản dùng riêng.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.disneyplus.com/*",
        "https://*.hbomax.com/*",
        "https://*.max.com/*",
        "https://*.primevideo.com/*",
        "https://www.amazon.com/*",
        "https://www.amazon.co.uk/*",
        "https://www.amazon.de/*",
        "https://www.amazon.co.jp/*",
        "https://tv.apple.com/*"
      ],
      "js": ["src/page/sniffer.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.disneyplus.com/*",
        "https://*.hbomax.com/*",
        "https://*.max.com/*",
        "https://*.primevideo.com/*",
        "https://www.amazon.com/*",
        "https://www.amazon.co.uk/*",
        "https://www.amazon.de/*",
        "https://www.amazon.co.jp/*",
        "https://tv.apple.com/*"
      ],
      "js": [
        "src/content/settings.js",
        "src/content/parsers.js",
        "src/content/sources.js",
        "src/content/translate.js",
        "src/content/narrator.js",
        "src/content/overlay.js",
        "src/content/panel.js",
        "src/content/main.js"
      ],
      "css": ["src/content/styles.css"],
      "run_at": "document_start"
    }
  ]
}
